{
  "schemaVersion": 1,
  "version": "2026-08-28.1",
  "apps": [
    {
      "id": "bridge-mira",
      "name": "Mira",
      "description": {
        "en": "Fertility Tracker",
        "fr": "Tracker de fertilité"
      },
      "icon": {
        "type": "base64",
        "value": "data:image/png;base64,"
      },
      "category": "medical",
      "provider": "Quanovate Inc.",
      "hook": {
        "initiate": {
          "method": "POST",
          "url": "https://demo-bridge-mira.datasafe.dev/mira/initiate",
          "auth": "ApiEndpoint ${apiEndpoint}",
          "body": {
            "returnUrl": "${returnUrl}"
          },
          "openUrlField": "openUrl"
        },
        "open": {
          "url": "${openUrl}",
          "embed": false
        },
        "resync": {
          "initiate": {
            "method": "POST",
            "url": "https://demo-bridge-mira.datasafe.dev/mira/resync",
            "auth": "ApiEndpoint ${apiEndpoint}",
            "body": {
              "returnUrl": "${returnUrl}"
            },
            "openUrlField": "openUrl"
          },
          "url": "${openUrl}",
          "embed": false
        },
        "disconnect": {
          "method": "POST",
          "url": "https://demo-bridge-mira.datasafe.dev/mira/revoke",
          "auth": "ApiEndpoint ${apiEndpoint}"
        }
      },
      "lastSync": {
        "type": "api",
        "url": "https://demo-bridge-mira.datasafe.dev/mira/lastSync",
        "auth": "ApiEndpoint ${apiEndpoint}",
        "field": "lastSyncedAt",
        "needsReauthField": "needsReauth",
        "faultyField": "faulty",
        "connectedField": "connected"
      }
    },
    {
      "id": "bridge-cyclefeminin",
      "name": "cyclefeminin",
      "description": {
        "en": "Import your cyclefeminin cycle history into HDS",
        "fr": "Importez votre historique de cycle cyclefeminin dans HDS"
      },
      "consentMessage": {
        "en": "The cyclefeminin importer will read your exported cyclefeminin JSON file in your browser and write the cycle, fertility and body-sign events into your HDS account. Nothing is uploaded anywhere else.",
        "fr": "L'importateur cyclefeminin lit le fichier JSON exporté depuis cyclefeminin dans votre navigateur et écrit les événements de cycle, de fertilité et de signes corporels dans votre compte HDS. Rien n'est envoyé ailleurs."
      },
      "icon": {
        "type": "base64",
        "value": "data:image/png;base64,"
      },
      "category": "health",
      "provider": "cyclefeminin.net",
      "actionButton": {
        "label": {
          "en": "Upload new data",
          "fr": "Importer de nouvelles données"
        }
      },
      "permissions": [
        {
          "streamId": "cyclefeminin-custom",
          "defaultName": "Cyclefeminin (imported)",
          "level": "manage"
        },
        {
          "streamId": "cyclefeminin-custom-mucus-notes",
          "defaultName": "mucus notes",
          "level": "manage"
        },
        {
          "streamId": "cyclefeminin-custom-day-comments",
          "defaultName": "day comments",
          "level": "manage"
        },
        {
          "streamId": "cyclefeminin-custom-cycle-comments",
          "defaultName": "cycle comments",
          "level": "manage"
        },
        {
          "streamId": "cyclefeminin-custom-cycle-method",
          "defaultName": "cycle method",
          "level": "manage"
        },
        {
          "streamId": "cyclefeminin-custom-cycle-temperature-context",
          "defaultName": "cycle temperature context",
          "level": "manage"
        },
        {
          "streamId": "body-temperature-basal",
          "defaultName": "body-temperature-basal",
          "level": "manage"
        },
        {
          "streamId": "body-vulva-bleeding",
          "defaultName": "body-vulva-bleeding",
          "level": "manage"
        },
        {
          "streamId": "body-vulva-mucus-inspect",
          "defaultName": "body-vulva-mucus-inspect",
          "level": "manage"
        },
        {
          "streamId": "fertility-cycles-start",
          "defaultName": "fertility-cycles-start",
          "level": "manage"
        },
        {
          "streamId": "fertility-cycles-peak-day",
          "defaultName": "fertility-cycles-peak-day",
          "level": "manage"
        },
        {
          "streamId": "fertility-cycles-fertile-window",
          "defaultName": "fertility-cycles-fertile-window",
          "level": "manage"
        },
        {
          "streamId": "fertility-ttc-tta",
          "defaultName": "fertility-ttc-tta",
          "level": "manage"
        },
        {
          "streamId": "fertility-sexual-activity",
          "defaultName": "fertility-sexual-activity",
          "level": "manage"
        },
        {
          "streamId": "symptom-gastrointestinal-cramps",
          "defaultName": "symptom-gastrointestinal-cramps",
          "level": "manage"
        },
        {
          "streamId": "symptom-sleep-insomnia",
          "defaultName": "symptom-sleep-insomnia",
          "level": "manage"
        }
      ],
      "hook": {
        "open": {
          "url": "https://demo-bridge-cycles-files.datasafe.dev/cyclefem",
          "embed": true,
          "params": {
            "apiEndpoint": "${apiEndpoint}",
            "return": "${returnUrl}"
          }
        }
      },
      "lastSync": {
        "type": "pryv-stream",
        "streamId": ".bridge-cyclefeminin.imports"
      }
    },
